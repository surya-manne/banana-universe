{
  "name": "@banana-universe/bananajs",
  "description": "An opinionated Node.js framework built on Express, designed for simplicity, scalability, and ease of use in building server-side applications.",
  "author": "Surya Prakash Manne",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprakas/banana-universe.git"
  },
  "homepage": "https://github.com/sprakas/banana-universe/tree/main/packages/bananajs",
  "license": "MIT",
  "version": "0.5.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@scalar/express-api-reference": ">=0.8.0",
    "awilix": ">=11.0.0",
    "express": "^4.21.2",
    "express-rate-limit": ">=7.0.0",
    "multer": ">=1.4.0",
    "prom-client": ">=15.0.0",
    "sanitize-html": ">=2.0.0",
    "swagger-ui-express": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@scalar/express-api-reference": {
      "optional": true
    },
    "awilix": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    },
    "multer": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "sanitize-html": {
      "optional": true
    },
    "swagger-ui-express": {
      "optional": true
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.3.0",
    "uuid": "^8.3.2",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/multer": "^1.4.12",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "awilix": "^13.0.3",
    "express-rate-limit": "^8.3.1",
    "prom-client": "^15.0.0",
    "sanitize-html": "^2.15.0",
    "supertest": "^7.2.2"
  }
}
