{
  "name": "@banana-universe/bananajs",
  "description": "An opinionated Node.js framework built on Express, designed for simplicity, scalability, and ease of use in building server-side applications.",
  "author": "Surya Prakash Manne",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprakas/banana-universe.git"
  },
  "homepage": "https://github.com/sprakas/banana-universe/tree/main/packages/bananajs",
  "license": "MIT",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "awilix": ">=11.0.0",
    "class-validator": "^0.14.1",
    "express": "^4.21.2"
  },
  "peerDependenciesMeta": {
    "awilix": {
      "optional": true
    }
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.3.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2"
  }
}
