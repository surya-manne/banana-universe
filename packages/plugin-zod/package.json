{
  "name": "@banana-universe/plugin-zod",
  "version": "0.1.0",
  "description": "Zod validation plugin for BananaJS — @ZodBody, @ZodQuery, @ZodParams decorators as an alternative to class-validator.",
  "author": "Surya Prakash Manne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprakas/banana-universe.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
