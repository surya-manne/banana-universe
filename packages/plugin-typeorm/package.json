{
  "name": "@banana-universe/plugin-typeorm",
  "version": "0.1.0",
  "description": "TypeORM plugin for BananaJS — DataSource registration, @InjectRepository, and @Transactional decorator.",
  "author": "Surya Prakash Manne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surya-manne/banana-universe.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@banana-universe/bananajs": ">=0.6.0",
    "@banana-universe/ddd": ">=0.1.0",
    "typeorm": ">=0.3.0"
  },
  "devDependencies": {
    "@banana-universe/bananajs": "*",
    "@banana-universe/ddd": "*",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.0"
  }
}
