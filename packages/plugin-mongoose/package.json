{
  "name": "@banana-universe/plugin-mongoose",
  "version": "0.1.0",
  "description": "Mongoose plugin for BananaJS — Connection registration, @Transactional (sessions), and Repository adapter.",
  "author": "Surya Prakash Manne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surya-manne/banana-universe.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@banana-universe/bananajs": ">=0.6.0",
    "@banana-universe/ddd": ">=0.1.0",
    "mongoose": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": false
    }
  },
  "devDependencies": {
    "@banana-universe/bananajs": "*",
    "@banana-universe/ddd": "*",
    "express": "^4.21.2",
    "mongoose": "^8.9.0",
    "reflect-metadata": "^0.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
