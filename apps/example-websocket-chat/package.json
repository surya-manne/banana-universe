{
  "name": "@banana-universe/example-websocket-chat",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Recipe: WebSocket chat rooms with @WsBody validation and HTTP health checks",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest": "cd ../../packages/bananajs && npx tsc -p tsconfig.lib.json && cd ../plugin-websocket && npx tsc -p tsconfig.lib.json",
    "test": "npm run build && node --test dist/__tests__/app.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "@banana-universe/bananajs": "0.6.1",
    "@banana-universe/plugin-websocket": "0.1.1",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.18.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@banana-universe/bananajs-cli": "0.5.1",
    "@eslint/js": "^9.8.0",
    "@types/node": "~18.16.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^2.6.2",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.19.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "~5.7.2"
  }
}
