{
  "name": "@banana-universe/example-rest-postgresql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recipe: TypeORM + PostgreSQL, DDD layers, auth, pagination, OTel, Swagger",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest": "cd ../../packages/bananajs && npx tsc -p tsconfig.lib.json && cd ../ddd && npx tsc -p tsconfig.lib.json && cd ../plugin-typeorm && npx tsc -p tsconfig.lib.json && cd ../plugin-otel && npx tsc -p tsconfig.lib.json",
    "test": "npm run build && NODE_ENV=test node --test dist/__tests__/app.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "@banana-universe/bananajs": "*",
    "@banana-universe/ddd": "*",
    "@banana-universe/plugin-otel": "*",
    "@banana-universe/plugin-typeorm": "*",
    "tsyringe": "^4.8.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@banana-universe/bananajs-cli": "*",
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^2.6.2",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.19.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.40.0",
    "@opentelemetry/sdk-node": "^0.50.0",
    "@types/node": "~18.16.9",
    "sql.js": "^1.11.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "~5.7.2"
  }
}
