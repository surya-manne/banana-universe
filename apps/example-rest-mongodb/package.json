{
  "name": "@banana-universe/example-rest-mongodb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recipe: Mongoose + Zod — document model and validation",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest": "cd ../../packages/bananajs && npx tsc -p tsconfig.lib.json && cd ../plugin-mongoose && npx tsc -p tsconfig.lib.json && cd ../../apps/example-rest-mongodb",
    "test": "npm run build && DATABASE_URL=${DATABASE_URL:-mongodb://127.0.0.1:27017/ci_dummy} node --test dist/__tests__/app.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "@banana-universe/bananajs": "*",
    "@banana-universe/plugin-mongoose": "*",
    "tsyringe": "^4.8.0",
    "express": "^4.21.2",
    "mongoose": "^8.9.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@banana-universe/bananajs-cli": "*",
    "@eslint/js": "^9.8.0",
    "@types/node": "~18.16.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^2.6.2",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.19.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "~5.7.2"
  }
}
